# Hugging Face Inference
HF_MODEL=openai/gpt-oss-20b:groq
HF_TOKEN=hf_xxx_your_token_here

# Generation controls
HF_TEMPERATURE=0.2
HF_TOP_P=0.9
MAX_HISTORY_MESSAGES=16
EPISODIC_TOP_K=3

# Logging
LOG_LEVEL=INFO
LOGGER=true
LOGGER_COLOR=true

ENABLE_TOOLS=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=csv_db
DB_USER=csv_user
DB_PASSWORD=csv_pass

# Qdrant semantic search
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=products
SEMANTIC_TOP_K=5

EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
